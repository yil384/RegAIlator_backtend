{
  "apps": [
    {
      "name": "app",
      "script": "src/index.js",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "time": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "restart_delay": 3000,
      "kill_timeout": 5000,
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
